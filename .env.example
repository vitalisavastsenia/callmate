# Optional Docker Compose overrides. Defaults work without copying this file.
CALLMATE_MODE=simulator
# Enables only the local development relay endpoint; live calls remain disabled.
NODE_ENV=development
TELEPHONY_PROVIDER=mock
# Optional URL overrides for a separately hosted mock; the combined Compose stack
# derives these defaults from its service names and port settings.
# CALLMATE_MOCK_API_BASE=http://mock-relay:8080
# CALLMATE_MOCK_OPERATOR_ORIGIN=http://localhost:8080
# CALLMATE_MOCK_RELAY_URL=ws://zeus-llama:3001/ws/voice
MOCK_ACCOUNT_SID=AC00000000000000000000000000000000
MOCK_API_USERNAME=mock
MOCK_API_PASSWORD=mock-local-only
# Synthetic signing token: match the standalone mock service, never a real Twilio token.
MOCK_AUTH_TOKEN=mock-auth-token-local-only
CALLMATE_API_PORT=3000
CALLMATE_CALLBACK_PORT=3001
# CALLMATE_API_PORT serves both the Zeus Llama UI and API.
# CALLMATE_WEB_PORT is only for the optional Vite dev profile.
# Container-to-container mock HTTP remains on port 8080.
CALLMATE_WEB_PORT=5173
CALLMATE_MOCK_PORT=8080
# Explicit URL overrides above take precedence over these port-aware defaults.
CALLMATE_LOG_LEVEL=info
# End connected calls without caller activity (seconds, 5–600).
CALLMATE_SILENCE_TIMEOUT_SECONDS=60
# Optional synthetic rate in USD cents per elapsed minute (1–60000).
# No default rate; omit/leave empty for unavailable usage. Never a provider price.
# CALLMATE_TEST_RATE_USD_MINOR_PER_MINUTE=60
CALLMATE_SIMULATOR_SCENARIO=within_plan
CALLMATE_SIMULATOR_STEP_MS=750
CALLMATE_SIMULATOR_APPROVAL_SECONDS=30

# SQLite is stored at /data in the container's callmate-data volume.
# Real Twilio credentials are not consumed. Optional OpenAI credentials below
# are injected only into the server container; never into the web container.

# codex-turn.mjs uses saved ChatGPT login: no .env/API key required.
# Optional trusted CLI configuration (uncomment to override defaults):
# CODEX_PATH=/absolute/path/to/codex
# CODEX_MODEL=your-supported-codex-model

# Optional separately billed OpenAI API settings (server and openai-turn.mjs).
# Prefer Settings → LLM agent for encrypted server-side key storage. These legacy
# environment defaults remain supported; saved UI selections override defaults.
# Server/local example only. Copy to .env; never put the real key in browser code.
OPENAI_API_KEY=replace-with-your-openai-api-key
# Explicit model ID available to your API account; Responses + Structured Outputs required.
OPENAI_MODEL=replace-with-your-codex-api-model-id
# Optional legacy Claude bootstrap; prefer entering the key in Settings.
# ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key

# Optional dialogue-driven conversations through the LOCAL mock.
# Codex subscription login: use compose.codex.yaml + scripts/setup-codex-login.sh.
# Optional persistent local selection (after setup):
# COMPOSE_FILE=compose.yaml:compose.codex.yaml
# Disabled by default; real phone calling and booking acceptance stay unavailable.
CALLMATE_DIALOGUE_PROVIDER=disabled
# To enable: set provider=openai, provide a real server-only OPENAI_API_KEY above,
# and choose an explicit Responses + Structured Outputs model your account supports.
# CALLMATE_DIALOGUE_MODEL=your-supported-model-id
CALLMATE_DIALOGUE_TIMEOUT_MS=10000
# Non-Docker only: private directory outside the database backup directory.
# CALLMATE_LLM_SECRETS_DIR=/absolute/private/zeus-secrets
# Optional externally managed master key: exactly 32 random bytes, owner-only
# readable, mounted into the server. Never store it beside database backups.
# CALLMATE_LLM_MASTER_KEY_FILE=/run/secrets/zeus-llm-master
# Build-time default for fresh browsers; rebuild Zeus Llama after changing.
# Existing Settings selection wins. Codex override builds with false.
# VITE_MOCK=false
