# Optional Docker Compose overrides. Defaults work without copying this file.
CALLMATE_MODE=simulator
# Enables only the local development relay endpoint; live calls remain disabled.
NODE_ENV=development
TELEPHONY_PROVIDER=mock
# Both URLs must point only to the local development services.
CALLMATE_MOCK_API_BASE=http://host.docker.internal:8080
CALLMATE_MOCK_OPERATOR_ORIGIN=http://localhost:8080
CALLMATE_MOCK_RELAY_URL=ws://host.docker.internal:3001/ws/voice
MOCK_ACCOUNT_SID=AC00000000000000000000000000000000
MOCK_API_USERNAME=mock
MOCK_API_PASSWORD=mock-local-only
# Synthetic signing token: match the standalone mock service, never a real Twilio token.
MOCK_AUTH_TOKEN=mock-auth-token-local-only
CALLMATE_API_PORT=3000
CALLMATE_CALLBACK_PORT=3001
CALLMATE_LOG_LEVEL=info
# End connected calls without caller activity (seconds, 5–600).
CALLMATE_SILENCE_TIMEOUT_SECONDS=60
# Optional synthetic rate in USD cents per elapsed minute (1–60000).
# No default rate; omit/leave empty for unavailable usage. Never a provider price.
# CALLMATE_TEST_RATE_USD_MINOR_PER_MINUTE=60
CALLMATE_SIMULATOR_SCENARIO=within_plan
CALLMATE_SIMULATOR_STEP_MS=750
CALLMATE_SIMULATOR_APPROVAL_SECONDS=30

# SQLite is stored at /data in the container's callmate-data volume.
# Twilio/LLM credentials are not consumed by this scaffold. Add them only when
# their adapters and explicit Compose runtime injection are implemented.

# codex-turn.mjs uses saved ChatGPT login: no .env/API key required.
# Optional trusted CLI configuration (uncomment to override defaults):
# CODEX_PATH=/absolute/path/to/codex
# CODEX_MODEL=your-supported-codex-model

# Only openai-turn.mjs uses these separately billed API settings.
# Server/local example only. Copy to .env; never put the real key in browser code.
OPENAI_API_KEY=replace-with-your-openai-api-key
# Explicit model ID available to your API account; Responses + Structured Outputs required.
OPENAI_MODEL=replace-with-your-codex-api-model-id
