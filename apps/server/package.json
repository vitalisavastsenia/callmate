    "fastify": "5.12.7",
    "twilio": "6.2.0",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "happy-dom": "^20.14.6",
    "typescript": "7.0.2"
  }
