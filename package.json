{
  "name": "callmate",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/contracts",
    "packages/dialogue",
    "apps/server",
    "apps/web"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev --workspace @callmate/web",
    "build": "npm run build --workspaces",
    "typecheck": "npm run build --workspace @callmate/contracts && npm run typecheck --workspaces",
    "test": "npm run test --workspaces"
  },
  "devDependencies": {
    "@types/node": "26.6.3"
  }
}
